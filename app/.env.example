# Copy this file to .env.local (never commit it) and fill in what you need.
# Every value is optional: without keys the office still runs, the TV shows a short built-in list and the
# chat screens say they are not connected.

# YouTube Data API v3 key for the TV's YouTube app. It is built into the page, so restrict it to your
# site's domain in Google Cloud.
VITE_YOUTUBE_KEY=

# Server side only (the /api/chat route: Vite dev / preview server locally, a Vercel function in production)
GEMINI_API_KEY=
# Model id; defaults to gemini-3.5-flash-lite when empty
CHAT_MODEL=
# 1 = show Claude's name and mark on the chat screens even though the configured model answers (demo look)
CHAT_PREVIEW_CLAUDE=
